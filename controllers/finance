export const getStudentLedger = async (req, res) => {
  try {
    const { studentId } = req.params;
    const { term, session } = req.query; 

    if (!term || !session) {
      return res.status(400).json({ success: false, message: "Missing term or session." });
    }

    const student = await Student.findById(studentId);
    if (!student) {
      return res.status(404).json({ success: false, message: "Student not found." });
    }

    const studentNormalizedClass = normalizeClassName(student.currentClass);
    const currentStructure = await FeeStructure.findOne({ 
      className: student.currentClass, 
      term, 
      session 
    });

    const isStructureActive = currentStructure?.status === 'Active' || currentStructure?.status === 'active';

    let currentExpected = 0;
    let currentPersonalizedItems = [];
    let currentStudentType = (student.admittedSession || student.admissionSession) === session ? 'New Students' : 'Returning Students';

    if (currentStructure) {
      currentPersonalizedItems = currentStructure.items.filter(item => 
        item.checked !== false && (item.appliesTo === 'All Students' || item.appliesTo === currentStudentType)
      );
      currentExpected = currentPersonalizedItems.reduce((sum, item) => sum + (Number(item.amount) || 0), 0);
    }

    const allSuccessfulPayments = await Payment.find({ studentId, status: 'Successful' });
    const aggregatePaid = allSuccessfulPayments.reduce((sum, log) => sum + log.amountPaid, 0);

    let basePreviousOutstanding = Number(student.previousOutstanding) || 0;
    let workingCredit = aggregatePaid;

    let computedPrevious = Math.max(0, basePreviousOutstanding - workingCredit);
    workingCredit = Math.max(0, workingCredit - basePreviousOutstanding);

    let computedCurrentOutstanding = Math.max(0, currentExpected - workingCredit);

    let finalPrevious = computedPrevious;
    let finalCurrentExpected = currentExpected;
    let finalCurrentOutstanding = computedCurrentOutstanding;

    if (!isStructureActive) {
      finalPrevious += computedCurrentOutstanding;
      finalCurrentExpected = 0;
      finalCurrentOutstanding = 0;
    }

    res.status(200).json({
      success: true,
      data: {
        student,
        studentType: currentStudentType,
        items: isStructureActive ? currentPersonalizedItems : [],
        paymentHistory: allSuccessfulPayments.filter(p => p.term === term && p.session === session),
        currentTermFee: finalCurrentExpected,
        totalPaid: aggregatePaid,
        previousOutstanding: finalPrevious,
        totalOutstanding: finalCurrentOutstanding + finalPrevious
      }
    });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message });
  }
};

